{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "million-day",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-01",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "million-day",
			"database_id": "9379c45c-9ce0-4487-946f-a8eae877ecdf",
			"migrations_dir": "migrations"
		}
	],
	"triggers": {
		// Orari UTC: coprono le estrazioni delle 13:00 e delle 20:30 con ora solare e legale.
		"crons": [
			"25 11,12 * * *",
			"55 18,19 * * *"
		]
	}
}
