@charset "utf-8";

html { font-size: 16px; }

body, p, a, div, table, td, th { font-size: 1rem; }

h1 { font-size: 1.3rem; }

h2 { font-size: 1.2rem; }

h3 { font-size: 1.1rem; }

body { background-color: rgb(61, 113, 92); font-family: Arial, Helvetica, sans-serif; color: rgb(0, 0, 0); margin: 3px 0px; }

img { border-style: none; }

img.resp { max-width: 100%; height: auto; }

img.inp { float: left; margin-right: 8px; border-radius: 3px; }

p { text-align: justify; margin: 8px 5px; }

.bordo { border: 1px solid rgb(74, 74, 74); }

.div_in_col { display: inline-block; font-family: monospace; margin-right: 1.5rem; white-space: pre; vertical-align: top; }

a:link, a:visited { color: rgb(0, 82, 189); text-decoration: none; font-weight: bold; }

a:hover { color: rgb(0, 0, 255); text-decoration: underline; }

a:active { color: rgb(0, 0, 255); text-decoration: none; }

.txtcentr { text-align: center; }

#menu { border-top: 1px solid rgb(255, 255, 255); border-bottom: 1px solid rgb(0, 0, 0); background-color: rgb(239, 239, 239); text-align: center; padding: 2px 0px; }

#menu_icon { box-shadow: none; vertical-align: middle; margin-left: 1rem; }

#menu_icon:hover { box-shadow: rgb(245, 130, 32) 0px 0px 3px; }

#opzioni { max-width: 21rem; margin: 4px auto auto; padding-top: 4px; }

a.clink:link, a.clink:visited { background: -webkit-gradient(linear, 0% 0%, 0% 100%, color-stop(0.05, rgb(249, 255, 249)), to(rgb(233, 249, 233))) rgb(249, 255, 249); text-indent: 0px; border: 1px solid rgb(202, 202, 202); display: inline-block; color: rgb(0, 80, 176); font-style: normal; padding: 6px 0px; text-decoration: none; text-align: left; text-shadow: rgb(255, 255, 255) 1px 1px 0px; width: 98%; margin-bottom: 3px; font-weight: normal; }

a.clink:hover { background: -webkit-gradient(linear, 0% 0%, 0% 100%, color-stop(0.05, rgb(233, 249, 233)), to(rgb(249, 255, 249))) rgb(233, 233, 233); }

a.clink:active { position: relative; top: 1px; }

.opz_icon { vertical-align: middle; margin: 0px; padding: 0px 3px; }

#content { margin: 4px; border: 1px solid rgb(170, 164, 164); border-radius: 4px 4px 0px 0px; padding: 1px 1px 4px; background-color: rgb(255, 255, 255); }

#error_msg { text-align: center; padding: 0.25rem 0.25rem 0.4rem; border: 1px solid rgb(153, 0, 0); color: rgb(255, 0, 0); border-radius: 3px; background-color: rgb(255, 255, 204); margin: 0.5rem; font-size: 1.2rem; }

#error_mg_title { padding: 0.4rem; color: rgb(255, 255, 204); background-color: rgb(204, 102, 51); font-weight: bold; margin-bottom: 0.5rem; font-size: 1.3rem; }

.pag_title { padding: 5px 8px; margin: 0px; background: rgb(255, 246, 158); font-weight: bold; border-radius: 4px 4px 0px 0px; color: rgb(65, 65, 65); text-shadow: rgb(255, 255, 255) 1px 1px 0px; }

.par_title { font-weight: bold; margin-left: 5px; margin-bottom: 0px; }

input[type="submit"], input[type="button"], input[type="file"] { font-size: 1rem; }

input[type="text"], input[type="password"], select, textarea { font-size: 1rem; border: 1px solid rgb(105, 111, 111); border-radius: 3px; }

.tba, .graf, .grafre, .grapr { margin: auto; border: 1px solid rgb(128, 128, 128); background-color: rgb(252, 252, 252); border-collapse: collapse; }

